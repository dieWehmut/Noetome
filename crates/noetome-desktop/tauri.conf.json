{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noetome",
  "version": "0.2.0",
  "identifier": "com.noetome.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Noetome",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 600,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "个人学科学习知识编译器",
    "longDescription": "Noetome 本地知识编译测试版。提供项目与真实PDF资料库、逐页解析及现成本机OCR、整书有界模型编译、持久进度与累计预算、暂停恢复、知识查询和证据定位，以及新目录Obsidian待核验笔记导出、离线样例自检、托盘和窗口设置。科学核验、完整图文语义、正式审批与生产发布分别验收。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
