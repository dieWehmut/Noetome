* text=auto
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
# Preserve exact source bytes and their declared hashes in future fixtures.
tests/fixtures/** -text
# Fixture SHA contracts sign original bytes; Windows checkouts keep them stable.
fixtures/text-compare-v1/** text eol=lf
# PDF corpus and author freezes are hashed as original bytes.
fixtures/pdf-text-v1/** -text
# Acceptance archives sign their original bytes, including JSON line endings.
doc/validation/B03-T02.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
doc/validation/B03-T02-evidence/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
doc/validation/B03-T03.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
doc/validation/B03-T03-evidence/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
# Native logs retain their final empty line; still check spaces at line ends.
doc/validation/B03-T03-evidence/**/*.log -text whitespace=blank-at-eol,space-before-tab,cr-at-eol,-blank-at-eof
# Saved PDF xref spacing and binary inventories are part of their fingerprints.
doc/validation/B03-T03-evidence/**/*.bin binary
doc/validation/B03-T03-evidence/**/*.sqlite binary
sidecars/pdf_parser/runtime-lock.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
# B04 original-byte acceptance archives, including native logs and SQLite/raw data.
doc/validation/B04-T01.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
doc/validation/B04-T01-evidence/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
doc/validation/B04-T01-evidence/**/*.log -text whitespace=blank-at-eol,space-before-tab,cr-at-eol,-blank-at-eof
doc/validation/B04-T01-evidence/**/*.bin binary
doc/validation/B04-T01-evidence/**/*.sqlite binary
doc/validation/B04-T01-evidence/**/*.pdf binary
# B04-T02 local evidence preserves raw test whitespace and original log bytes.
doc/validation/B04-T02-local.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
doc/validation/B04-T02-local-evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
doc/validation/B04-T02-local-evidence/**/*.bin binary
doc/validation/B04-T02-local-evidence/**/*.sqlite binary
