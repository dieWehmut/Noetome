* text=auto
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
# Preserve exact source bytes and their declared hashes in future fixtures.
tests/fixtures/** -text
# Fixture SHA contracts sign original bytes; Windows checkouts keep them stable.
fixtures/text-compare-v1/** text eol=lf
# PDF evidence must retain its exact binary bytes on every checkout.
*.pdf binary
*.zlib binary
# Preserve recorded command bytes and their archived fingerprints on Windows.
doc/validation/assets/B03-T02-*.log -text whitespace=cr-at-eol
doc/validation/assets/B03-T02-*.json -text whitespace=cr-at-eol
