<!DOCTYPE html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="UTF-8">
<script>
(function(){
	var defined = ["en","ar","bn","de","es","fr","it","ja","ko","pl","pt-BR","ro","ru","sv","zh"];
	var dflt = 'en';
	var cur = 'en';
	var pref = null;
	try { pref = localStorage.getItem('lang'); } catch(e) {}
	if (!pref && cur === dflt) return;
	if (pref && pref === cur) return;
	var target = pref;
	if (!target) {
		var langs = (navigator.languages || [navigator.language || '']);
		for (var i = 0; i < langs.length; i++) {
			var code = langs[i].toLowerCase().split('-')[0];
			if (defined.indexOf(code) !== -1) { target = code; break; }
		}
	}
	if (!target || target === cur) return;
	var p = location.pathname;
	// Strip any locale prefix from path
	p = p.replace(new RegExp('^/(' + defined.join('|') + ')(/|$)'), '/');
	// Don't redirect app routes
	if (/^\/(account|buy)(\/|$)/.test(p)) return;
	if (target !== dflt) p = '/' + target + (p === '/' ? '/' : p);
	if (p.replace(/\/$/, '') === location.pathname.replace(/\/$/, '')) return;
	location.replace(p + location.search + location.hash);
})();
</script>
