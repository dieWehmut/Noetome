{
  "schema_version": 1,
  "provider": "openai_chat_completions",
  "transport_mode": "local_http_test",
  "endpoint": "http://127.0.0.1:37807/v1/chat/completions",
  "model": "noetome-test-mixed-key",
  "credential_env": "NOETOME_TEST_SCAN_CREDENTIAL",
  "required_input": "vision",
  "capabilities": {
    "text": true,
    "vision": true,
    "structured_output": true
  },
  "limits": {
    "max_input_bytes": 12288,
    "max_response_bytes": 262144,
    "max_output_tokens": 8192,
    "timeout_ms": 60000
  },
  "budget": {
    "max_requests": 1,
    "max_total_tokens": 65536,
    "max_cost_usd": null
  }
}
