    "version_id": "a2896979-54dd-4e33-8f44-c07f3a427d75",
    "revision": 1,
    "raw_sha256": "5aa51f5816ec39ac4eefd7a8299def081d33a2277a8fdddb66243b4a741c7591",
    "normalized_sha256": "5aa51f5816ec39ac4eefd7a8299def081d33a2277a8fdddb66243b4a741c7591",
    "normalization_version": "utf8-newlines-v1",
